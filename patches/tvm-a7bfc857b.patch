diff --git a/src/target/opt/build_metal_off.cc b/src/target/opt/build_metal_off.cc
index 7f544d92f..33ef33425 100644
--- a/src/target/opt/build_metal_off.cc
+++ b/src/target/opt/build_metal_off.cc
@@ -19,18 +19,71 @@
 
 /*!
  *  Optional module when build metal is switched to off
+ *
+ *  Local patch: the stock fallback returned a generic DeviceSourceModule, whose
+ *  SaveToBytes layout (fmt, fmap, source) does not match what the Metal runtime's
+ *  ffi.Module.load_from_bytes.metal reads (version, smap, fmap, fmt) -- so a Metal artifact
+ *  cross-compiled on a USE_METAL=OFF host failed to load on the Mac (std::bad_alloc while
+ *  deserializing). This source-only module keeps the per-kernel smap and serializes it in
+ *  MetalModuleNode's exact layout (src/runtime/metal/metal_module.mm SaveToBytes), so the
+ *  exported library loads on a Metal-enabled runtime.
  */
+#include <tvm/support/io.h>
+
 #include "../../runtime/metal/metal_module.h"
+#include "../../support/bytes_io.h"
 #include "../source/codegen_source_base.h"
 
 namespace tvm {
 namespace runtime {
 
+// Must match kMetalModuleVersion in src/runtime/metal/metal_module.mm.
+static constexpr const char* kMetalModuleVersionForCrossCompile = "0.1.0";
+
+class MetalSourceOnlyModuleNode final : public ffi::ModuleObj {
+ public:
+  MetalSourceOnlyModuleNode(std::unordered_map<std::string, std::string> smap,
+                            ffi::Map<ffi::String, FunctionInfo> fmap, std::string fmt,
+                            std::string source)
+      : smap_(std::move(smap)), fmap_(fmap), fmt_(std::move(fmt)), source_(std::move(source)) {}
+
+  const char* kind() const final { return "metal"; }
+
+  int GetPropertyMask() const final { return ffi::Module::kBinarySerializable; }
+
+  ffi::Optional<ffi::Function> GetFunction(const ffi::String& name) final {
+    TVM_FFI_THROW(InternalError) << "Metal source module cannot execute; build TVM with Metal "
+                                 << "runtime support or load the exported library on a Mac";
+  }
+
+  ffi::String InspectSource(const ffi::String& format) const final { return source_; }
+
+  ffi::Bytes SaveToBytes() const final {
+    std::string result;
+    support::BytesOutStream stream(&result);
+    std::string version = kMetalModuleVersionForCrossCompile;
+    stream.Write(version);
+    stream.Write(smap_);
+    stream.Write(fmap_);
+    stream.Write(fmt_);
+    return ffi::Bytes(std::move(result));
+  }
+
+ private:
+  std::unordered_map<std::string, std::string> smap_;
+  ffi::Map<ffi::String, FunctionInfo> fmap_;
+  std::string fmt_;
+  std::string source_;
+};
+
 ffi::Module MetalModuleCreate(std::unordered_map<std::string, std::string> smap,
                               ffi::Map<ffi::String, FunctionInfo> fmap, std::string fmt,
                               std::string source) {
-  LOG(WARNING) << "Metal runtime not enabled, return a source module...";
-  return codegen::DeviceSourceModuleCreate(source, fmt, fmap, "metal");
+  LOG(WARNING) << "Metal runtime not enabled, return a source-only metal module "
+               << "(serializable for a Metal-enabled runtime)...";
+  auto n = ffi::make_object<MetalSourceOnlyModuleNode>(std::move(smap), fmap, std::move(fmt),
+                                                       std::move(source));
+  return ffi::Module(n);
 }
 
 }  // namespace runtime
